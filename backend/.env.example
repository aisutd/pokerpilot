# Copy this file to .env and fill in values on the server only.
# Supabase PostgreSQL connection used by backend authentication.
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Supabase API placeholders for future API integration.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
# Server only: never expose the service role key to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API configuration.
GEMINI_API_KEY=
GEMINI_MODEL=
