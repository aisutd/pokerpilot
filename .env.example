# Copy to .env in the repository root. This connection string is for the
# backend only; replace YOUR_DATABASE_PASSWORD locally and never commit .env.
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.ojdkitpsmtcokrwdeedr.supabase.co:5432/postgres?sslmode=require

# Set to 1 only when serving PokerPilot over HTTPS.
POKERPILOT_COOKIE_SECURE=0

# Optional: stable Flask session key for game-room session cookies.
POKERPILOT_SECRET=replace-with-a-random-secret
